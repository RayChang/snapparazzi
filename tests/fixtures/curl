#!/bin/sh
# Fake curl for installer tests: records the URL and serves a local source archive.
#   SNAPPARAZZI_TEST_ARCHIVE    archive to return
#   SNAPPARAZZI_TEST_CURL_LOG   file that receives the requested URL
#   SNAPPARAZZI_TEST_CURL_FAIL  when set, simulate an HTTP failure (curl -f exit 22)

set -eu

: "${SNAPPARAZZI_TEST_ARCHIVE:?}"
: "${SNAPPARAZZI_TEST_CURL_LOG:?}"

output=""
url=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o)
      shift
      output="${1:-}"
      ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done

[ -n "$output" ] || exit 64
[ -n "$url" ] || exit 64

printf '%s\n' "$url" > "$SNAPPARAZZI_TEST_CURL_LOG"
[ -z "${SNAPPARAZZI_TEST_CURL_FAIL:-}" ] || exit 22
cp "$SNAPPARAZZI_TEST_ARCHIVE" "$output"
